{
  "enabled": true,
  "name": "Task Completion Commit",
  "description": "Monitors code files for changes and prompts to commit after task completion with user confirmation. Add the same description as task.",
  "version": "1",
  "when": {
    "type": "userTriggered",
    "patterns": [
      "pictia-app/src/**/*.ts",
      "pictia-app/src/**/*.tsx",
      "pictia-app/*.ts",
      "pictia-app/*.tsx",
      "pictia-app/*.js",
      "pictia-app/*.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A task appears to be completed based on recent file changes. Please review the changes and ask the user for confirmation before committing the code. Once confirmed, commit the changes with an appropriate commit message describing what was accomplished."
  }
}